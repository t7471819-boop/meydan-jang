<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>بازی سه‌بعدی تفنگی</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body { width: 100%; height: 100%; overflow: hidden; background: #000;
    font-family: Tahoma; touch-action: none; user-select: none; position: fixed; }
  canvas { display: block; }

  #hud { position: fixed; inset: 0; pointer-events: none;
    color: white; text-shadow: 2px 2px 5px #000; z-index: 10; }
  #health { position: absolute; top: 8px; right: 10px; font-size: 15px; color: #ff5555;
    background: rgba(0,0,0,0.5); padding: 4px 12px; border-radius: 20px; }
  #enemyCount { position: absolute; top: 8px; right: 90px; font-size: 13px; color: #88ccff;
    background: rgba(0,0,0,0.5); padding: 4px 12px; border-radius: 20px; }
  #weapon { position: absolute; top: 8px; left: 10px; font-size: 14px; color: #ffaa00;
    background: rgba(0,0,0,0.5); padding: 4px 12px; border-radius: 20px; }
  #ammo { position: absolute; top: 8px; left: 90px; font-size: 13px; color: #ffdd44;
    background: rgba(0,0,0,0.5); padding: 4px 12px; border-radius: 20px; }

  #joyZone { position: fixed; bottom: 15px; left: 15px; width: 110px; height: 110px;
    border-radius: 50%; background: rgba(255,255,255,0.13);
    border: 2px solid rgba(255,255,255,0.35); z-index: 20; touch-action: none; }
  #joyKnob { position: absolute; width: 50px; height: 50px; border-radius: 50%;
    background: rgba(255,255,255,0.55); top: 50%; left: 50%;
    transform: translate(-50%,-50%); pointer-events: none; }

  #fireBtn { position: fixed; bottom: 15px; right: 15px; width: 78px; height: 78px;
    border-radius: 50%; background: radial-gradient(circle, rgba(255,60,60,0.95), rgba(180,20,20,0.95));
    border: 3px solid rgba(255,255,255,0.6); z-index: 25; color: white; font-size: 12px;
    font-weight: bold; display: flex; align-items: center; justify-content: center;
    touch-action: none; box-shadow: 0 0 18px rgba(255,0,0,0.6); }
  #fireBtn:active { transform: scale(0.92); }

  #zoomBtn, #reloadBtn { position: fixed; width: 50px; height: 50px; border-radius: 50%;
    background: rgba(0,0,0,0.55); border: 2px solid rgba(255,255,255,0.4);
    color: white; font-size: 20px; z-index: 22; display: flex;
    align-items: center; justify-content: center; touch-action: none; }
  #zoomBtn { bottom: 100px; right: 15px; }
  #reloadBtn { bottom: 100px; right: 72px; }
  #zoomBtn:active, #reloadBtn:active { background: rgba(255,165,0,0.6); }

  #weaponBtns { position: fixed; bottom: 15px; left: 140px; display: flex;
    flex-direction: column; gap: 6px; z-index: 22; }
  .wbtn { width: 72px; height: 38px; border-radius: 10px;
    background: rgba(0,0,0,0.55); border: 2px solid rgba(255,255,255,0.3);
    color: white; font-size: 12px; display: flex;
    align-items: center; justify-content: center; touch-action: none; }
  .wbtn.active { background: rgba(255,165,0,0.8); border-color: #fff;
    box-shadow: 0 0 12px rgba(255,165,0,0.6); }

  #msg { position: fixed; top: 22%; left: 50%; transform: translate(-50%,-50%);
    color: white; font-size: 22px; text-shadow: 3px 3px 8px #000;
    z-index: 30; pointer-events: none; text-align: center;
    background: rgba(0,0,0,0.6); padding: 10px 20px; border-radius: 12px;
    opacity: 0; transition: opacity 0.3s; }

  #startScreen { position: fixed; inset: 0;
    background: linear-gradient(135deg, #1a1a2e, #16213e);
    color: white; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    z-index: 100; text-align: center; padding: 15px; transition: opacity 0.4s; }
  #startScreen h1 { color: #ffcc00; margin-bottom: 10px; font-size: 22px; }
  #startScreen p { font-size: 12px; line-height: 1.6; max-width: 650px; }

  .bigBtn { margin-top: 15px; padding: 12px 40px; font-size: 18px; font-family: Tahoma;
    font-weight: bold; color: white; background: linear-gradient(135deg, #ff6b00, #ff3300);
    border: 3px solid #ffcc00; border-radius: 50px; cursor: pointer;
    box-shadow: 0 6px 20px rgba(255, 80, 0, 0.5), 0 0 30px rgba(255, 200, 0, 0.3);
    transition: all 0.2s; animation: btnPulse 1.8s infinite;
    touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
  .bigBtn:active { transform: scale(0.94);
    box-shadow: 0 3px 10px rgba(255, 80, 0, 0.7), 0 0 40px rgba(255, 200, 0, 0.6); }
  @keyframes btnPulse {
    0%, 100% { box-shadow: 0 6px 20px rgba(255, 80, 0, 0.5), 0 0 30px rgba(255, 200, 0, 0.3); }
    50% { box-shadow: 0 6px 25px rgba(255, 80, 0, 0.8), 0 0 50px rgba(255, 200, 0, 0.6); }
  }

  #gameOverScreen { position: fixed; inset: 0; background: rgba(0,0,0,0.88);
    color: white; display: none; flex-direction: column;
    align-items: center; justify-content: center;
    z-index: 110; text-align: center; padding: 15px; }
  #gameOverScreen h1 { font-size: 32px; margin-bottom: 10px; text-shadow: 4px 4px 10px #000; }
  #gameOverScreen.win h1 { color: #44ff88; }
  #gameOverScreen.lose h1 { color: #ff4444; }
  #gameOverScreen p { font-size: 14px; margin-bottom: 12px; color: #ccc; }

  #crosshair { position: fixed; top: 50%; left: 50%; width: 22px; height: 22px;
    transform: translate(-50%,-50%); pointer-events: none; z-index: 15; }
  #crosshair::before, #crosshair::after {
    content: ''; position: absolute; background: #fff; box-shadow: 0 0 4px #000; }
  #crosshair::before { left: 50%; top: 0; width: 2px; height: 100%; transform: translateX(-50%); }
  #crosshair::after { top: 50%; left: 0; height: 2px; width: 100%; transform: translateY(-50%); }

  #hitmarker { position: fixed; top: 50%; left: 50%; width: 26px; height: 26px;
    transform: translate(-50%,-50%) rotate(45deg); pointer-events: none;
    z-index: 16; display: none; }
  #hitmarker::before, #hitmarker::after {
    content: ''; position: absolute; background: #ff3333; }
  #hitmarker::before { left: 50%; top: 0; width: 3px; height: 100%; transform: translateX(-50%); }
  #hitmarker::after { top: 50%; left: 0; height: 3px; width: 100%; transform: translateY(-50%); }

  #damageOverlay { position: fixed; inset: 0; pointer-events: none;
    background: radial-gradient(circle, transparent 40%, rgba(255,0,0,0.6) 100%);
    opacity: 0; transition: opacity 0.3s; z-index: 14; }

  #rotateMsg { display: none; position: fixed; inset: 0;
    background: linear-gradient(135deg, #1a1a2e, #16213e);
    color: white; z-index: 200; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center; padding: 30px; }
  #rotateMsg .icon { font-size: 70px; margin-bottom: 20px;
    animation: rotateAnim 2s infinite; }
  #rotateMsg h2 { color: #ffcc00; font-size: 22px; margin-bottom: 15px; }
  #rotateMsg p { font-size: 15px; color: #ccc; }
  @keyframes rotateAnim {
    0%, 40% { transform: rotate(0deg); }
    60%, 100% { transform: rotate(90deg); }
  }
  @media (orientation: portrait) and (max-width: 768px) {
    #rotateMsg { display: flex; }
  }
  @media (orientation: landscape) and (max-height: 420px) {
    #health { font-size: 13px; padding: 3px 10px; }
    #enemyCount { font-size: 11px; padding: 3px 10px; right: 80px; }
    #weapon { font-size: 12px; padding: 3px 10px; }
    #ammo { font-size: 11px; padding: 3px 10px; left: 80px; }
    #joyZone { width: 95px; height: 95px; bottom: 10px; left: 10px; }
    #joyKnob { width: 42px; height: 42px; }
    #fireBtn { width: 68px; height: 68px; bottom: 10px; right: 10px; font-size: 11px; }
    #zoomBtn, #reloadBtn { width: 44px; height: 44px; font-size: 17px; }
    #zoomBtn { bottom: 85px; right: 10px; }
    #reloadBtn { bottom: 85px; right: 60px; }
    #weaponBtns { left: 115px; bottom: 10px; gap: 5px; }
    .wbtn { width: 65px; height: 34px; font-size: 11px; }
  }
</style>
</head>
<body>

<div id="hud">
  <div id="health">❤️ 10</div>
  <div id="enemyCount">👥 8</div>
  <div id="weapon">رگبار</div>
  <div id="ammo">🔫 30/30</div>
</div>

<div id="crosshair"></div>
<div id="hitmarker"></div>
<div id="msg"></div>
<div id="damageOverlay"></div>

<div id="joyZone"><div id="joyKnob"></div></div>
<div id="fireBtn">🔥 شلیک</div>
<div id="zoomBtn">🔍</div>
<div id="reloadBtn">🔄</div>
<div id="weaponBtns">
  <div class="wbtn active" data-w="rifle">رگبار</div>
  <div class="wbtn" data-w="sniper">اسنایپ</div>
  <div class="wbtn" data-w="shotgun">شات‌گان</div>
</div>

<div id="startScreen">
  <h1>🎯 بازی سه‌بعدی تفنگی</h1>
  <p>
    📱 <b>کنترل موبایل (گوشی رو افقی بگیر):</b><br>
    🕹️ جوی‌استیک چپ → حرکت &nbsp;|&nbsp; 👆 کشیدن انگشت روی صفحه → چرخش دوربین<br>
    🔥 دکمه قرمز → شلیک (نگه‌دار برای رگبار) &nbsp;|&nbsp; 🔍 دکمه زوم → اسنایپ<br>
    🔄 دکمه وسط → پر کردن خشاب &nbsp;|&nbsp; دکمه‌های چپ → تغییر سلاح<br><br>
    🟢 جعبه سبز = مهمات &nbsp;|&nbsp; 🔴 جعبه قرمز = جان &nbsp;|&nbsp; 🟫 سنگرها مانع حرکت
  </p>
  <button id="startBtn" class="bigBtn">🚀 شروع بازی</button>
</div>

<div id="gameOverScreen">
  <h1 id="gameOverTitle">بازی تمام شد</h1>
  <p id="gameOverMsg"></p>
  <button id="restartBtn" class="bigBtn">🔄 شروع دوباره</button>
</div>

<div id="rotateMsg">
  <div class="icon">📱</div>
  <h2>گوشی رو افقی بگیر!</h2>
  <p>برای تجربه بهتر، گوشی رو به حالت افقی بچرخون</p>
</div>

<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.160.0/build/three.module.js"
  }
}
</script>

<script type="module">
import * as THREE from 'three';

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x87CEEB);
scene.fog = new THREE.Fog(0x87CEEB, 60, 220);

const camera = new THREE.PerspectiveCamera(75, innerWidth/innerHeight, 0.1, 600);
const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
renderer.setSize(innerWidth, innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
document.body.appendChild(renderer.domElement);

scene.add(new THREE.AmbientLight(0xffffff, 0.65));
const sun = new THREE.DirectionalLight(0xffffff, 1);
sun.position.set(50, 100, 50);
sun.castShadow = true;
sun.shadow.mapSize.set(1024, 1024);
sun.shadow.camera.left = -80;
sun.shadow.camera.right = 80;
sun.shadow.camera.top = 80;
sun.shadow.camera.bottom = -80;
scene.add(sun);

function groundHeight(x, z) {
  const dist = Math.sqrt(x*x + z*z);
  const damp = Math.min(1, dist / 20);
  return (
    Math.sin(x*0.05) * Math.cos(z*0.05) * 1.5 +
    Math.sin(x*0.15 + 1) * Math.cos(z*0.12) * 0.6 +
    Math.sin(x*0.3) * 0.3
  ) * damp;
}

const groundGeo = new THREE.PlaneGeometry(300, 300, 80, 80);
groundGeo.rotateX(-Math.PI/2);
const gpos = groundGeo.attributes.position;
for (let i = 0; i < gpos.count; i++) {
  gpos.setY(i, groundHeight(gpos.getX(i), gpos.getZ(i)));
}
gpos.needsUpdate = true;
groundGeo.computeVertexNormals();

const ground = new THREE.Mesh(groundGeo, new THREE.MeshStandardMaterial({
  color: 0x3d8b37, roughness: 0.95
}));
ground.receiveShadow = true;
scene.add(ground);

const tuftMat = new THREE.MeshStandardMaterial({ color: 0x2d6b27 });
for (let i = 0; i < 120; i++) {
  const a = Math.random() * Math.PI * 2;
  const r = 15 + Math.random() * 100;
  const x = Math.cos(a)*r, z = Math.sin(a)*r;
  const tuft = new THREE.Mesh(new THREE.ConeGeometry(0.3, 0.8, 4), tuftMat);
  tuft.position.set(x, groundHeight(x,z) + 0.3, z);
  scene.add(tuft);
}

const coverMat = new THREE.MeshStandardMaterial({ color: 0x8B7355, roughness: 1 });
const covers = [];
const coverLayout = [
  [10, 10, 4, 2, 1.5], [-15, 8, 5, 1.5, 2], [15, -12, 3, 2, 2],
  [-20, -15, 4, 1.5, 2.5], [0, 20, 6, 2, 1.5], [-25, 5, 3, 1.5, 2],
  [25, 20, 4, 2, 2], [-30, -20, 5, 2, 1.8],
];

function buildCovers() {
  coverLayout.forEach(([x, z, w, h, d]) => {
    const cover = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), coverMat);
    cover.position.set(x, groundHeight(x,z) + h/2, z);
    cover.castShadow = true;
    cover.receiveShadow = true;
    scene.add(cover);
    covers.push({ mesh: cover, w, h, d });
  });
}
buildCovers();

let pickups = [];
const ammoMat = new THREE.MeshStandardMaterial({ color: 0x22cc22, emissive: 0x115511 });
const healthMat = new THREE.MeshStandardMaterial({ color: 0xcc2222, emissive: 0x551111 });

function spawnPickup(x, z, type) {
  const mesh = new THREE.Mesh(new THREE.BoxGeometry(1, 1, 1), type === 'ammo' ? ammoMat : healthMat);
  mesh.position.set(x, groundHeight(x,z) + 1, z);
  mesh.castShadow = true;
  scene.add(mesh);
  pickups.push({ mesh, type, bob: Math.random()*Math.PI*2 });
}

function buildPickups() {
  for (let i = 0; i < 12; i++) {
    const a = Math.random()*Math.PI*2, r = 20 + Math.random()*80;
    spawnPickup(Math.cos(a)*r, Math.sin(a)*r, 'ammo');
  }
  for (let i = 0; i < 5; i++) {
    const a = Math.random()*Math.PI*2, r = 30 + Math.random()*70;
    spawnPickup(Math.cos(a)*r, Math.sin(a)*r, 'health');
  }
}
buildPickups();

const WEAPONS = {
  rifle:   { name: 'رگبار',   maxAmmo: 30, damage: 20,  fireRate: 0.1, range: 80,  spread: 0.025, auto: true,  zoom: 1.3, kick: 0.015 },
  sniper:  { name: 'اسنایپ',  maxAmmo: 8,  damage: 100, fireRate: 0.8, range: 200, spread: 0.001, auto: false, zoom: 4,   kick: 0.09 },
  shotgun: { name: 'شات‌گان', maxAmmo: 6,  damage: 60,  fireRate: 0.7, range: 20,  spread: 0.15,  auto: false, zoom: 1.1, kick: 0.07, pellets: 8 }
};

let currentWeapon = 'rifle';
let ammo = { rifle: 30, sniper: 8, shotgun: 6 };

let player = {
  pos: new THREE.Vector3(0, 0, 0),
  yaw: 0, pitch: 0,
  health: 10, maxHealth: 10,
  speed: 8,
  lastShot: 0,
  zooming: false,
  height: 1.7,
  bobTime: 0,
  recoilOffset: 0,
  recoilPitch: 0,
  recoilRoll: 0,
};

let weaponGroup = new THREE.Group();
scene.add(weaponGroup);

const gunBody = new THREE.Mesh(
  new THREE.BoxGeometry(0.12, 0.15, 0.9),
  new THREE.MeshStandardMaterial({ color: 0x222222, roughness: 0.7, metalness: 0.6 })
);
gunBody.position.set(0, 0, -0.4);
weaponGroup.add(gunBody);

const gunBarrel = new THREE.Mesh(
  new THREE.CylinderGeometry(0.04, 0.04, 0.7, 8),
  new THREE.MeshStandardMaterial({ color: 0x111111, metalness: 0.8, roughness: 0.4 })
);
gunBarrel.rotation.x = Math.PI/2;
gunBarrel.position.set(0, 0.02, -1.0);
weaponGroup.add(gunBarrel);

const gunMag = new THREE.Mesh(
  new THREE.BoxGeometry(0.08, 0.25, 0.15),
  new THREE.MeshStandardMaterial({ color: 0x333333 })
);
gunMag.position.set(0, -0.18, -0.3);
weaponGroup.add(gunMag);

const gunGrip = new THREE.Mesh(
  new THREE.BoxGeometry(0.08, 0.2, 0.1),
  new THREE.MeshStandardMaterial({ color: 0x1a1a1a })
);
gunGrip.position.set(0, -0.15, 0.1);
weaponGroup.add(gunGrip);

const WEAPON_BASE_POS = new THREE.Vector3(0.32, -0.28, -0.6);
weaponGroup.position.copy(WEAPON_BASE_POS);

const muzzleGroup = new THREE.Group();
muzzleGroup.position.set(0, 0.02, -1.35);
weaponGroup.add(muzzleGroup);

const flashCore = new THREE.Mesh(
  new THREE.SphereGeometry(0.12, 8, 8),
  new THREE.MeshBasicMaterial({ color: 0xffffaa, transparent: true, opacity: 0 })
);
muzzleGroup.add(flashCore);

const flashCone = new THREE.Mesh(
  new THREE.ConeGeometry(0.15, 0.45, 6),
  new THREE.MeshBasicMaterial({ color: 0xffaa00, transparent: true, opacity: 0 })
);
flashCone.rotation.x = -Math.PI/2;
flashCone.position.z = -0.2;
muzzleGroup.add(flashCone);

const flashStar = new THREE.Group();
for (let i = 0; i < 4; i++) {
  const plane = new THREE.Mesh(
    new THREE.PlaneGeometry(0.35, 0.08),
    new THREE.MeshBasicMaterial({ color: 0xffdd33, transparent: true, opacity: 0, side: THREE.DoubleSide })
  );
  plane.rotation.z = (i * Math.PI / 4);
  flashStar.add(plane);
}
flashStar.position.z = -0.05;
muzzleGroup.add(flashStar);

const muzzleLight = new THREE.PointLight(0xffaa33, 0, 8);
muzzleGroup.add(muzzleLight);

let flashTime = 0;
const FLASH_DURATION = 0.06;

function triggerFlash() {
  flashTime = FLASH_DURATION;
  flashCore.material.opacity = 1;
  flashCone.material.opacity = 0.9;
  muzzleLight.intensity = 4;
  flashStar.children.forEach(p => p.material.opacity = 0.85);
  const scale = 0.8 + Math.random() * 0.5;
  flashCone.scale.set(scale, scale, scale);
  flashStar.scale.set(scale, scale, scale);
  flashStar.rotation.z = Math.random() * Math.PI;
}

function updateFlash(dt) {
  if (flashTime > 0) {
    flashTime -= dt;
    const t = Math.max(0, flashTime / FLASH_DURATION);
    flashCore.material.opacity = t;
    flashCone.material.opacity = t * 0.9;
    muzzleLight.intensity = t * 4;
    flashStar.children.forEach(p => p.material.opacity = t * 0.85);
  } else {
    flashCore.material.opacity = 0;
    flashCone.material.opacity = 0;
    muzzleLight.intensity = 0;
    flashStar.children.forEach(p => p.material.opacity = 0);
  }
}

const smokeParticles = [];
function spawnSmoke() {
  const smoke = new THREE.Mesh(
    new THREE.SphereGeometry(0.06, 6, 6),
    new THREE.MeshBasicMaterial({ color: 0xaaaaaa, transparent: true, opacity: 0.6 })
  );
  smoke.position.set((Math.random()-0.5)*0.1, 0.02 + Math.random()*0.1, -1.4);
  weaponGroup.add(smoke);
  smokeParticles.push({
    mesh: smoke, life: 0.6, maxLife: 0.6,
    vy: 0.4 + Math.random()*0.3,
    vx: (Math.random()-0.5)*0.3
  });
}

function updateSmoke(dt) {
  for (let i = smokeParticles.length - 1; i >= 0; i--) {
    const s = smokeParticles[i];
    s.life -= dt;
    s.mesh.position.y += s.vy * dt;
    s.mesh.position.x += s.vx * dt;
    s.mesh.scale.multiplyScalar(1 + dt * 2);
    s.mesh.material.opacity = (s.life / s.maxLife) * 0.6;
    if (s.life <= 0) {
      weaponGroup.remove(s.mesh);
      smokeParticles.splice(i, 1);
    }
  }
}

let enemies = [];
const enemyBodyMat = new THREE.MeshStandardMaterial({ color: 0x222288 });
const enemyHeadMat = new THREE.MeshStandardMaterial({ color: 0xddb088 });
const enemyGunMat = new THREE.MeshStandardMaterial({ color: 0x333333 });

function createEnemy(x, z, hasGun) {
  const group = new THREE.Group();

  const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.4, 1.0, 4, 8), enemyBodyMat);
  body.position.y = 1.0;
  body.castShadow = true;
  group.add(body);

  const head = new THREE.Mesh(new THREE.SphereGeometry(0.3, 12, 12), enemyHeadMat);
  head.position.y = 1.85;
  head.castShadow = true;
  group.add(head);

  const eyeMat = new THREE.MeshBasicMaterial({ color: 0xff2222 });
  const eye = new THREE.Mesh(new THREE.SphereGeometry(0.05, 6, 6), eyeMat);
  eye.position.set(0, 1.9, -0.28);
  group.add(eye);

  if (hasGun) {
    const gun = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.15, 1.2), enemyGunMat);
    gun.position.set(0.4, 1.3, 0.5);
    gun.castShadow = true;
    group.add(gun);
  }

  group.position.set(x, groundHeight(x,z), z);
  scene.add(group);

  const enemy = {
    group, health: 100, hasGun,
    gunCooldown: 2 + Math.random()*2,
    speed: 2 + Math.random()*1.5,
    lastAttack: 0, alive: true,
  };
  enemies.push(enemy);
}

function buildEnemies() {
  for (let i = 0; i < 8; i++) {
    const a = Math.random()*Math.PI*2, r = 25 + Math.random()*60;
    createEnemy(Math.cos(a)*r, Math.sin(a)*r, Math.random() < 0.6);
  }
}
buildEnemies();

let bullets = [];
const bulletGeo = new THREE.SphereGeometry(0.08, 6, 6);
const bulletMat = new THREE.MeshBasicMaterial({ color: 0xffff00 });
const enemyBulletMat = new THREE.MeshBasicMaterial({ color: 0xff3300 });

function spawnBulletVisual(from, to, isEnemy) {
  const dir = new THREE.Vector3().subVectors(to, from);
  const len = dir.length();
  dir.normalize();

  const trailGeo = new THREE.BufferGeometry().setFromPoints([from.clone(), to.clone()]);
  const trailMat = new THREE.LineBasicMaterial({
    color: isEnemy ? 0xff3300 : 0xffff66,
    transparent: true, opacity: 0.8
  });
  const trail = new THREE.Line(trailGeo, trailMat);
  scene.add(trail);
  setTimeout(() => scene.remove(trail), 100);

  const bullet = new THREE.Mesh(bulletGeo, isEnemy ? enemyBulletMat : bulletMat);
  bullet.position.copy(from);
  scene.add(bullet);

  bullets.push({
    mesh: bullet, dir, speed: 200,
    traveled: 0, maxDist: len, isEnemy,
    startPos: from.clone(),
  });
}

let joyX = 0, joyY = 0;
let joyActive = false;
let joyTouchId = null;
let lookTouchId = null;
let lastLookX = 0, lastLookY = 0;
let firing = false;
let zoomTouchId = null;

const joyZone = document.getElementById('joyZone');
const joyKnob = document.getElementById('joyKnob');
const fireBtn = document.getElementById('fireBtn');
const zoomBtn = document.getElementById('zoomBtn');
const reloadBtn = document.getElementById('reloadBtn');

function getCenter(el) {
  const r = el.getBoundingClientRect();
  return { x: r.left + r.width/2, y: r.top + r.height/2, r: r.width/2 };
}

joyZone.addEventListener('touchstart', e => {
  e.preventDefault();
  e.stopPropagation();
  const t = e.changedTouches[0];
  joyTouchId = t.identifier;
  joyActive = true;
  updateJoy(t);
}, { passive: false });

joyZone.addEventListener('touchmove', e => {
  e.preventDefault();
  e.stopPropagation();
  for (const t of e.changedTouches) {
    if (t.identifier === joyTouchId) updateJoy(t);
  }
}, { passive: false });

joyZone.addEventListener('touchend', e => {
  e.preventDefault();
  e.stopPropagation();
  for (const t of e.changedTouches) {
    if (t.identifier === joyTouchId) {
      joyTouchId = null; joyActive = false;
      joyX = 0; joyY = 0;
      joyKnob.style.transform = 'translate(-50%,-50%)';
    }
  }
}, { passive: false });

function updateJoy(t) {
  const c = getCenter(joyZone);
  let dx = t.clientX - c.x;
  let dy = t.clientY - c.y;
  const dist = Math.sqrt(dx*dx + dy*dy);
  const maxR = c.r - 8;
  if (dist > maxR) { dx = dx/dist*maxR; dy = dy/dist*maxR; }
  joyKnob.style.transform = `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px))`;
  joyX = dx / maxR;
  joyY = dy / maxR;
}

document.addEventListener('touchstart', e => {
  if (lookTouchId !== null) return;
  const target = e.target;
  if (target.closest('#joyZone') || target.closest('#fireBtn') || 
      target.closest('#zoomBtn') || target.closest('#reloadBtn') ||
      target.closest('.wbtn') || target.closest('#startBtn') ||
      target.closest('#restartBtn') || target.closest('.bigBtn')) {
    return;
  }
  const t = e.changedTouches[0];
  lookTouchId = t.identifier;
  lastLookX = t.clientX;
  lastLookY = t.clientY;
}, { passive: true });

document.addEventListener('touchmove', e => {
  for (const t of e.changedTouches) {
    if (t.identifier === lookTouchId) {
      const dx = t.clientX - lastLookX;
      const dy = t.clientY - lastLookY;
      lastLookX = t.clientX;
      lastLookY = t.clientY;
      const sens = player.zooming ? 0.0008 : 0.0035;
      player.yaw   -= dx * sens;
      player.pitch -= dy * sens;
      player.pitch = Math.max(-Math.PI/2 + 0.1, Math.min(Math.PI/2 - 0.1, player.pitch));
    }
  }
}, { passive: true });

document.addEventListener('touchend', e => {
  for (const t of e.changedTouches) {
    if (t.identifier === lookTouchId) lookTouchId = null;
    if (t.identifier === zoomTouchId) { zoomTouchId = null; player.zooming = false; }
  }
}, { passive: true });

fireBtn.addEventListener('touchstart', e => {
  e.preventDefault();
  e.stopPropagation();
  firing = true;
}, { passive: false });
fireBtn.addEventListener('touchend', e => {
  e.preventDefault();
  e.stopPropagation();
  firing = false;
}, { passive: false });
fireBtn.addEventListener('touchcancel', e => { firing = false; });

zoomBtn.addEventListener('touchstart', e => {
  e.preventDefault();
  e.stopPropagation();
  zoomTouchId = e.changedTouches[0].identifier;
  player.zooming = true;
}, { passive: false });
zoomBtn.addEventListener('touchend', e => {
  e.preventDefault();
  e.stopPropagation();
  player.zooming = false;
  zoomTouchId = null;
}, { passive: false });

reloadBtn.addEventListener('touchstart', e => {
  e.preventDefault();
  e.stopPropagation();
  reload();
}, { passive: false });

document.querySelectorAll('.wbtn').forEach(btn => {
  btn.addEventListener('touchstart', e => {
    e.preventDefault();
    e.stopPropagation();
    switchWeapon(btn.dataset.w);
  }, { passive: false });
});

const keysDown = {};
addEventListener('keydown', e => {
  keysDown[e.code] = true;
  if (e.code === 'Digit1') switchWeapon('rifle');
  if (e.code === 'Digit2') switchWeapon('sniper');
  if (e.code === 'Digit3') switchWeapon('shotgun');
  if (e.code === 'KeyR') reload();
  if (e.code === 'Space') firing = true;
});
addEventListener('keyup', e => {
  keysDown[e.code] = false;
  if (e.code === 'Space') firing = false;
});

function switchWeapon(w) {
  if (currentWeapon === w) return;
  currentWeapon = w;
  document.getElementById('weapon').textContent = WEAPONS[w].name;
  document.querySelectorAll('.wbtn').forEach(b => {
    b.classList.toggle('active', b.dataset.w === w);
  });
  updateAmmoUI();
  weaponGroup.position.y = WEAPON_BASE_POS.y - 0.3;
}

function reload() {
  ammo[currentWeapon] = WEAPONS[currentWeapon].maxAmmo;
  updateAmmoUI();
}

function updateAmmoUI() {
  const w = WEAPONS[currentWeapon];
  document.getElementById('ammo').textContent = `🔫 ${ammo[currentWeapon]}/${w.maxAmmo}`;
}

function updateHealthUI() {
  document.getElementById('health').textContent = `❤️ ${player.health}`;
}

function updateEnemyCountUI() {
  const alive = enemies.filter(e => e.alive).length;
  document.getElementById('enemyCount').textContent = `👥 ${alive}`;
}

function showDamageOverlay() {
  const ov = document.getElementById('damageOverlay');
  ov.style.opacity = 1;
  setTimeout(() => ov.style.opacity = 0, 200);
}

function shoot(now) {
  const w = WEAPONS[currentWeapon];
  if (ammo[currentWeapon] <= 0) return;
  if (now - player.lastShot < w.fireRate) return;

  player.lastShot = now;
  ammo[currentWeapon]--;
  updateAmmoUI();

  triggerFlash();
  if (currentWeapon !== 'sniper') spawnSmoke();

  player.recoilOffset = 0.12 * (w.kick * 10);
  player.recoilPitch = w.kick;
  player.recoilRoll = (Math.random() - 0.5) * w.kick * 1.5;

  const baseDir = new THREE.Vector3(0, 0, -1).applyEuler(
    new THREE.Euler(player.pitch, player.yaw, 0, 'YXZ')
  );

  const pellets = w.pellets || 1;
  const hitEnemies = new Set();

  for (let p = 0; p < pellets; p++) {
    const dir = baseDir.clone();
    dir.x += (Math.random() - 0.5) * w.spread * 2;
    dir.y += (Math.random() - 0.5) * w.spread * 2;
    dir.z += (Math.random() - 0.5) * w.spread * 2;
    dir.normalize();

    const origin = camera.position.clone();
    let closestHit = null, closestDist = Infinity;

    for (const enemy of enemies) {
      if (!enemy.alive) continue;
      const enemyCenter = enemy.group.position.clone().add(new THREE.Vector3(0, 1.2, 0));
      const toEnemy = new THREE.Vector3().subVectors(enemyCenter, origin);
      const proj = toEnemy.dot(dir);
      if (proj < 0 || proj > w.range) continue;
      const closestPoint = origin.clone().add(dir.clone().multiplyScalar(proj));
      const distToLine = closestPoint.distanceTo(enemyCenter);
      const hitRadius = currentWeapon === 'shotgun' ? 1.0 : 0.8;
      if (distToLine < hitRadius && proj < closestDist) {
        closestDist = proj;
        closestHit = enemy;
      }
    }

    if (closestHit) {
      const hitPoint = origin.clone().add(dir.clone().multiplyScalar(closestDist));
      spawnBulletVisual(origin, hitPoint, false);
      if (!hitEnemies.has(closestHit)) {
        hitEnemies.add(closestHit);
        closestHit.health -= w.damage;
        showHitmarker();
        if (closestHit.health <= 0) killEnemy(closestHit);
      }
    } else {
      let endPoint = origin.clone().add(dir.clone().multiplyScalar(w.range));
      for (let t = 0; t < w.range; t += 2) {
        const pt = origin.clone().add(dir.clone().multiplyScalar(t));
        if (pt.y < groundHeight(pt.x, pt.z)) { endPoint = pt; break; }
        if (Math.abs(pt.x) > 150 || Math.abs(pt.z) > 150) { endPoint = pt; break; }
      }
      spawnBulletVisual(origin, endPoint, false);
    }
  }
}

function killEnemy(enemy) {
  enemy.alive = false;
  scene.remove(enemy.group);
  updateEnemyCountUI();
  if (Math.random() < 0.5) {
    spawnPickup(enemy.group.position.x, enemy.group.position.z,
                Math.random() < 0.7 ? 'ammo' : 'health');
  }
}

function showHitmarker() {
  const hm = document.getElementById('hitmarker');
  hm.style.display = 'block';
  setTimeout(() => hm.style.display = 'none', 100);
}

function updateEnemies(dt, now) {
  for (const enemy of enemies) {
    if (!enemy.alive) continue;
    const enemyPos = enemy.group.position;
    const toPlayer = new THREE.Vector3().subVectors(player.pos, enemyPos);
    toPlayer.y = 0;
    const distance = toPlayer.length();
    toPlayer.normalize();

    const targetAngle = Math.atan2(toPlayer.x, toPlayer.z);
    let angleDiff = targetAngle - enemy.group.rotation.y;
    while (angleDiff > Math.PI) angleDiff -= Math.PI*2;
    while (angleDiff < -Math.PI) angleDiff += Math.PI*2;
    enemy.group.rotation.y += angleDiff * dt * 3;

    const maxRange = enemy.hasGun ? 15 : 1.5;
    if (distance > maxRange) {
      const moveSpeed = enemy.speed * dt;
      const nx = enemyPos.x + toPlayer.x * moveSpeed;
      const nz = enemyPos.z + toPlayer.z * moveSpeed;
      let blocked = false;
      for (const c of covers) {
        const dx = nx - c.mesh.position.x;
        const dz = nz - c.mesh.position.z;
        if (Math.abs(dx) < c.w/2 + 0.5 && Math.abs(dz) < c.d/2 + 0.5) { blocked = true; break; }
      }
      if (!blocked) {
        enemyPos.x = nx; enemyPos.z = nz;
        enemyPos.y = groundHeight(nx, nz);
      }
    }

    if (enemy.hasGun && distance < 25 && distance > 2) {
      if (now - enemy.lastAttack > enemy.gunCooldown) {
        enemy.lastAttack = now;
        enemy.gunCooldown = 1.5 + Math.random()*1.5;
        if (Math.random() < 0.65) {
          player.health--;
          updateHealthUI();
          showDamageOverlay();
          const start = enemyPos.clone().add(new THREE.Vector3(0, 1.3, 0));
          spawnBulletVisual(start, camera.position.clone(), true);
        }
      }
    } else {
      if (distance < 2 && now - enemy.lastAttack > 1) {
        enemy.lastAttack = now;
        player.health--;
        updateHealthUI();
        showDamageOverlay();
      }
    }
  }
}

function updatePlayer(dt) {
  const forward = new THREE.Vector3(-Math.sin(player.yaw), 0, -Math.cos(player.yaw));
  const right = new THREE.Vector3(Math.cos(player.yaw), 0, -Math.sin(player.yaw));

  let move = new THREE.Vector3();
  if (joyActive && (Math.abs(joyX) > 0.1 || Math.abs(joyY) > 0.1)) {
    move.add(forward.clone().multiplyScalar(-joyY));
    move.add(right.clone().multiplyScalar(joyX));
  }
  if (keysDown['KeyW']) move.add(forward);
  if (keysDown['KeyS']) move.sub(forward);
  if (keysDown['KeyD']) move.add(right);
  if (keysDown['KeyA']) move.sub(right);

  const moving = move.length() > 0;
  if (moving) {
    move.normalize();
    const speed = player.speed * dt;
    let nx = player.pos.x + move.x * speed;
    let nz = player.pos.z + move.z * speed;

    for (const c of covers) {
      const dx = nx - c.mesh.position.x;
      const dz = nz - c.mesh.position.z;
      if (Math.abs(dx) < c.w/2 + 0.4 && Math.abs(dz) < c.d/2 + 0.4) {
        if (Math.abs(dx) > Math.abs(dz)) nx = player.pos.x;
        else nz = player.pos.z;
      }
    }
    nx = Math.max(-140, Math.min(140, nx));
    nz = Math.max(-140, Math.min(140, nz));
    player.pos.x = nx;
    player.pos.z = nz;
    player.bobTime += dt * 12;
  } else {
    player.bobTime *= 0.95;
  }

  player.pos.y = groundHeight(player.pos.x, player.pos.z) + player.height;

  const w = WEAPONS[currentWeapon];
  const targetFov = player.zooming ? 75 / w.zoom : 75;
  camera.fov += (targetFov - camera.fov) * Math.min(1, dt * 12);
  camera.updateProjectionMatrix();

  if (player.recoilPitch > 0.0001) {
    player.recoilPitch *= 0.82;
    player.recoilRoll *= 0.82;
  } else {
    player.recoilPitch = 0;
    player.recoilRoll = 0;
  }
}

function updateWeapon(dt) {
  const bobX = Math.sin(player.bobTime) * 0.008;
  const bobY = Math.abs(Math.cos(player.bobTime)) * 0.012;
  const isMoving = joyActive || keysDown['KeyW']||keysDown['KeyA']||keysDown['KeyS']||keysDown['KeyD'];
  const targetBobX = isMoving ? bobX : 0;
  const targetBobY = isMoving ? bobY : 0;

  const zoomFactor = camera.fov / 75;
  const baseX = WEAPON_BASE_POS.x * (0.4 + zoomFactor * 0.6);
  const baseY = WEAPON_BASE_POS.y * (0.4 + zoomFactor * 0.6);
  const baseZ = WEAPON_BASE_POS.z;

  const recoilBack = player.recoilOffset;
  const recoilUp   = player.recoilOffset * 0.6;

  if (player.recoilOffset > 0.001) player.recoilOffset *= 0.78;
  else player.recoilOffset = 0;

  weaponGroup.position.x += (baseX + targetBobX - weaponGroup.position.x) * Math.min(1, dt*15);
  weaponGroup.position.y += (baseY + targetBobY + recoilUp - weaponGroup.position.y) * Math.min(1, dt*20);
  weaponGroup.position.z += (baseZ + recoilBack - weaponGroup.position.z) * Math.min(1, dt*20);

  weaponGroup.rotation.x = -player.recoilOffset * 3;
  weaponGroup.rotation.z = player.recoilRoll * 2;
}

function updatePickups(dt) {
  for (let i = pickups.length - 1; i >= 0; i--) {
    const p = pickups[i];
    p.bob += dt * 3;
    p.mesh.position.y = groundHeight(p.mesh.position.x, p.mesh.position.z) + 1 + Math.sin(p.bob) * 0.2;
    p.mesh.rotation.y += dt;

    const dx = p.mesh.position.x - player.pos.x;
    const dz = p.mesh.position.z - player.pos.z;
    if (dx*dx + dz*dz < 4) {
      if (p.type === 'ammo') {
        for (const k in ammo) ammo[k] = WEAPONS[k].maxAmmo;
        updateAmmoUI();
        showMsg('مهمات پر شد!');
      } else {
        player.health = Math.min(player.maxHealth, player.health + 3);
        updateHealthUI();
        showMsg('جان +3');
      }
      scene.remove(p.mesh);
      pickups.splice(i, 1);
    }
  }
}

let msgTimer = 0;
function showMsg(text) {
  const el = document.getElementById('msg');
  el.textContent = text;
  el.style.opacity = 1;
  msgTimer = 1.2;
}

function updateBullets(dt) {
  for (let i = bullets.length - 1; i >= 0; i--) {
    const b = bullets[i];
    b.traveled += b.speed * dt;
    b.mesh.position.copy(b.startPos).add(b.dir.clone().multiplyScalar(b.traveled));
    if (b.traveled > b.maxDist) {
      scene.remove(b.mesh);
      bullets.splice(i, 1);
    }
  }
}

let gameOver = false;
let running = false;
let clockLast = performance.now();

function resetGame() {
  for (const e of enemies) {
    if (e.alive) scene.remove(e.group);
  }
  enemies = [];
  for (const p of pickups) scene.remove(p.mesh);
  pickups = [];
  for (const b of bullets) scene.remove(b.mesh);
  bullets = [];
  for (const s of smokeParticles) weaponGroup.remove(s.mesh);
  smokeParticles.length = 0;

  player.pos.set(0, 0, 0);
  player.yaw = 0;
  player.pitch = 0;
  player.health = 10;
  player.lastShot = 0;
  player.zooming = false;
  player.bobTime = 0;
  player.recoilOffset = 0;
  player.recoilPitch = 0;
  player.recoilRoll = 0;
  camera.fov = 75;
  camera.updateProjectionMatrix();

  currentWeapon = 'rifle';
  ammo = { rifle: 30, sniper: 8, shotgun: 6 };
  document.getElementById('weapon').textContent = WEAPONS.rifle.name;
  document.querySelectorAll('.wbtn').forEach(b => {
    b.classList.toggle('active', b.dataset.w === 'rifle');
  });
  updateAmmoUI();
  updateHealthUI();

  buildEnemies();
  buildPickups();
  updateEnemyCountUI();

  gameOver = false;
  firing = false;
  joyActive = false;
  joyX = 0;
  joyY = 0;
  joyKnob.style.transform = 'translate(-50%,-50%)';
}

const startScreen = document.getElementById('startScreen');
const startBtn = document.getElementById('startBtn');
const gameOverScreen = document.getElementById('gameOverScreen');
const restartBtn = document.getElementById('restartBtn');
const gameOverTitle = document.getElementById('gameOverTitle');
const gameOverMsg = document.getElementById('gameOverMsg');

function startGame() {
  resetGame();
  startScreen.style.opacity = '0';
  setTimeout(() => { startScreen.style.display = 'none'; }, 400);
  gameOverScreen.style.display = 'none';
  running = true;
  clockLast = performance.now();
}

function endGame(won) {
  gameOver = true;
  running = false;

  if (won) {
    gameOverScreen.classList.add('win');
    gameOverScreen.classList.remove('lose');
    gameOverTitle.textContent = '🏆 بردی!';
    gameOverMsg.textContent = 'همه دشمنان را نابود کردی!';
  } else {
    gameOverScreen.classList.add('lose');
    gameOverScreen.classList.remove('win');
    gameOverTitle.textContent = '💀 باختی!';
    gameOverMsg.textContent = 'جان‌هایت تمام شد...';
  }

  gameOverScreen.style.display = 'flex';
}

startBtn.addEventListener('click', startGame);
startBtn.addEventListener('touchend', e => {
  e.preventDefault();
  e.stopPropagation();
  startGame();
}, { passive: false });

restartBtn.addEventListener('click', () => {
  gameOverScreen.style.display = 'none';
  startGame();
});
restartBtn.addEventListener('touchend', e => {
  e.preventDefault();
  e.stopPropagation();
  gameOverScreen.style.display = 'none';
  startGame();
}, { passive: false });

function animate() {
  requestAnimationFrame(animate);
  const now = performance.now() / 1000;
  const dt = Math.min(0.05, (performance.now() - clockLast) / 1000);
  clockLast = performance.now();

  updateFlash(dt);
  updateSmoke(dt);
  updateWeapon(dt);

  if (running && !gameOver) {
    if (firing) {
      const w = WEAPONS[currentWeapon];
      if (w.auto || now - player.lastShot > w.fireRate) shoot(now);
    }

    updatePlayer(dt);
    updateEnemies(dt, now);
    updatePickups(dt);
    updateBullets(dt);

    const bobY = Math.sin(player.bobTime * 2) * 0.04;
    camera.position.copy(player.pos);
    camera.position.y += bobY;
    camera.rotation.order = 'YXZ';
    camera.rotation.y = player.yaw;
    camera.rotation.x = player.pitch + player.recoilPitch;
    camera.rotation.z = player.recoilRoll;

    if (player.health <= 0) {
      endGame(false);
    } else {
      const alive = enemies.filter(e => e.alive).length;
      if (alive === 0) endGame(true);
    }
  }

  if (msgTimer > 0 && msgTimer < 100) {
    msgTimer -= dt;
    if (msgTimer <= 0) document.getElementById('msg').style.opacity = 0;
  }

  renderer.render(scene, camera);
}

addEventListener('resize', () => {
  camera.aspect = innerWidth / innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});

updateAmmoUI();
updateHealthUI();
updateEnemyCountUI();
animate();
</script>
