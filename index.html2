<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>میدان جنگ - ۷ مرحله</title> 
<style>
  * { margin: 0; padding: 0;  box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body { width: 100%; height: 100%; overflow: hidden; background: #000;
    font-family: Tahoma; touch-action: none; user-select: none; position: fixed; }
  canvas { display: block; }
  #hud { position: fixed; inset: 0; pointer-events: none; color: white;
    text-shadow: 2px 2px 5px #000; z-index: 10; }
  #level { position: absolute; top: 8px; left: 50%; transform: translateX(-50%);
    font-size: 15px; color: #ffcc00; background: rgba(0,0,0,0.6);
    padding: 4px 16px; border-radius: 20px; font-weight: bold; }
  #health { position: absolute; top: 8px; right: 10px; font-size: 15px;
    color: #ff5555; background: rgba(0,0,0,0.6); padding: 4px 12px; border-radius: 20px; }
  #enemyCount { position: absolute; top: 40px; right: 10px; font-size: 13px;
    color: #88ccff; background: rgba(0,0,0,0.6); padding: 4px 12px; border-radius: 20px; }
  #allyCount { position: absolute; top: 72px; right: 10px; font-size: 13px;
    color: #88ff88; background: rgba(0,0,0,0.6); padding: 4px 12px; border-radius: 20px; }
  #weapon { position: absolute; top: 8px; left: 10px; font-size: 14px;
    color: #ffaa00; background: rgba(0,0,0,0.6); padding: 4px 12px; border-radius: 20px; }
  #ammo { position: absolute; top: 40px; left: 10px; font-size: 13px;
    color: #ffdd44; background: rgba(0,0,0,0.6); padding: 4px 12px; border-radius: 20px; }
  #joyZone { position: fixed; bottom: 15px; left: 15px; width: 105px; height: 105px;
    border-radius: 50%; background: rgba(255,255,255,0.13);
    border: 2px solid rgba(255,255,255,0.35); z-index: 20; touch-action: none; }
  #joyKnob { position: absolute; width: 48px; height: 48px; border-radius: 50%;
    background: rgba(255,255,255,0.55); top: 50%; left: 50%;
    transform: translate(-50%,-50%); pointer-events: none; }
  #fireBtn { position: fixed; bottom: 15px; right: 15px; width: 75px; height: 75px;
    border-radius: 50%; background: radial-gradient(circle, rgba(255,60,60,0.95), rgba(180,20,20,0.95));
    border: 3px solid rgba(255,255,255,0.6); z-index: 25; color: white; font-size: 11px;
    font-weight: bold; display: flex; align-items: center; justify-content: center;
    touch-action: none; box-shadow: 0 0 18px rgba(255,0,0,0.6); }
  #fireBtn:active { transform: scale(0.92); }
  #zoomBtn, #reloadBtn { position: fixed; width: 48px; height: 48px; border-radius: 50%;
    background: rgba(0,0,0,0.55); border: 2px solid rgba(255,255,255,0.4);
    color: white; font-size: 18px; z-index: 22; display: flex;
    align-items: center; justify-content: center; touch-action: none; }
  #zoomBtn { bottom: 98px; right: 15px; }
  #reloadBtn { bottom: 98px; right: 70px; }
  #zoomBtn:active, #reloadBtn:active { background: rgba(255,165,0,0.6); }
  #weaponBtns { position: fixed; bottom: 15px; left: 130px; display: flex;
    flex-direction: column; gap: 5px; z-index: 22; }
  .wbtn { width: 68px; height: 32px; border-radius: 8px;
    background: rgba(0,0,0,0.55); border: 2px solid rgba(255,255,255,0.3);
    color: white; font-size: 11px; display: flex;
    align-items: center; justify-content: center; touch-action: none; }
  .wbtn.active { background: rgba(255,165,0,0.8); border-color: #fff;
    box-shadow: 0 0 12px rgba(255,165,0,0.6); }
  #msg { position: fixed; top: 25%; left: 50%; transform: translate(-50%,-50%);
    color: white; font-size: 24px; text-shadow: 3px 3px 8px #000;
    z-index: 30; pointer-events: none;  text-align: center;
    background: rgba(0,0,0,0.75); padding: 15px 30px; border-radius: 15px;
    opacity: 0; transition: opacity 0.4s; font-weight: bold; }
  #startScreen { position: fixed; inset: 0;
    background: linear-gradient(135deg, #1a1a2e, #16213e);
    color: white; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    z-index: 100; text-align: center; padding: 15px; transition: opacity 0.4s; }
  #startScreen h1 { color: #ffcc00; margin-bottom: 10px; font-size: 24px; }
  #startScreen p { font-size: 12px; line-height: 1.7; max-width: 650px; }
  .bigBtn { margin-top: 15px; padding: 12px 40px; font-size: 18px; font-family: Tahoma;
    font-weight: bold; color: white; background: linear-gradient(135deg, #ff6b00, #ff3300);
    border: 3px solid #ffcc00; border-radius: 50px; cursor: pointer;
    box-shadow: 0 6px 20px rgba(255, 80, 0, 0.5);
    transition: all 0.2s; animation: btnPulse 1.8s infinite;
    touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
  .bigBtn:active { transform: scale(0.94); }
  @keyframes btnPulse {
    0%, 100% { box-shadow: 0 6px 20px rgba(255, 80, 0, 0.5); }
    50% { box-shadow: 0 6px 25px rgba(255, 80, 0, 0.9); }
  }
  #gameOverScreen { position: fixed; inset: 0; background: rgba(0,0,0,0.92);
    color: white; display: none; flex-direction: column;
    align-items: center; justify-content: center;
    z-index: 110; text-align: center; padding: 15px; }
  #gameOverScreen h1 { font-size: 32px; margin-bottom: 10px; }
  #gameOverScreen.win h1 { color: #44ff88; }
  #gameOverScreen.lose h1 { color: #ff4444; }
  #gameOverScreen p { font-size: 14px; margin-bottom: 12px; color: #ccc; }
  #crosshair { position: fixed; top: 50%; left: 50%; width: 22px; height: 22px;
    transform: translate(-50%,-50%); pointer-events: none; z-index: 15; }
  #crosshair::before, #crosshair::after {
    content: ''; position: absolute; background: #fff; box-shadow: 0 0 4px #000; }
  #crosshair::before { left: 50%; top: 0; width: 2px; height: 100%; transform: translateX(-50%); }
  #crosshair::after { top: 50%; left: 0; height: 2px; width: 100%; transform: translateY(-50%); }
  #damageOverlay { position: fixed; inset: 0; pointer-events: none;
    background: radial-gradient(circle, transparent 40%, rgba(255,0,0,0.6) 100%);
    opacity: 0; transition: opacity 0.3s; z-index: 14; }
  #rotateMsg { display: none; position: fixed; inset: 0;
    background: linear-gradient(135deg, #1a1a2e, #16213e);
    color: white; z-index: 200; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center; padding: 30px; }
  #rotateMsg .icon { font-size: 70px; margin-bottom: 20px;
    animation: rotateAnim 2s infinite; }
  #rotateMsg h2 { color: #ffcc00; font-size: 22px; margin-bottom: 15px; }
  #rotateMsg p { font-size: 15px; color: #ccc; }
  @keyframes rotateAnim {
    0%, 40% { transform: rotate(0deg); }
    60%, 100% { transform: rotate(90deg); }
  }
  @media (orientation: portrait) and (max-width: 768px) {
    #rotateMsg { display: flex; }
  }
</style>
</head>
<body>
<div id="hud">
  <div id="level">🎯 مرحله 1/7</div>
  <div id="health">❤️ 10</div>
  <div id="enemyCount">👥 0</div>
  <div id="allyCount">🤝 0</div>
  <div id="weapon">رگبار</div>
  <div id="ammo">🔫 30/30</div>
</div>
<div id="crosshair"></div>
<div id="msg"></div>
<div id="damageOverlay"></div>
<div id="joyZone"><div id="joyKnob"></div></div>
<div id="fireBtn">🔥 شلیک</div>
<div id="zoomBtn">🔍</div>
<div id="reloadBtn">🔄</div>
<div id="weaponBtns">
  <div class="wbtn active" data-w="pistol">کلت</div>
  <div class="wbtn" data-w="rifle">رگبار</div>
  <div class="wbtn" data-w="sniper">اسنایپ</div>
  <div class="wbtn" data-w="shotgun">شات‌گان</div>
</div>
<div id="startScreen">
  <h1>🎯 میدان جنگ</h1>
  <p>
    📱 <b>گوشی رو افقی بگیر!</b><br><br>
    🕹️ جوی‌استیک چپ → حرکت &nbsp;|&nbsp; 👆 کشیدن انگشت → چرخش<br>
    🔥 دکمه قرمز → شلیک &nbsp;|&nbsp; 🔍 دکمه زوم → اسنایپ<br>
    🔄 خشاب &nbsp;|&nbsp; ۴ دکمه سلاح: کلت، رگبار، اسنایپ، شات‌گان<br><br>
    🌍 <b>۷ مرحله با ۷ زمین:</b><br>
    🌱 چمن &nbsp;🌲 جنگل &nbsp;🏜️ بیابان &nbsp;❄️ برفی &nbsp;🌋 آتشفشان &nbsp;🌙 شب &nbsp;👑 پادشاه<br>
    🤝 از مرحله ۳ به بعد یار (همرزم) میاد!
  </p>
  <button id="startBtn" class="bigBtn">🚀 شروع بازی</button>
</div>
<div id="gameOverScreen">
  <h1 id="gameOverTitle">بازی تمام شد</h1>
  <p id="gameOverMsg"></p>
  <button id="restartBtn" class="bigBtn">🔄 شروع دوباره</button>
</div>
<div id="rotateMsg">
  <div class="icon">📱</div>
  <h2>گوشی رو افقی بگیر!</h2>
  <p>برای تجربه بهتر، گوشی رو افقی بچرخون</p>
</div>

<script type="importmap">
{ "imports": { "three": "https://unpkg.com/three@0.160.0/build/three.module.js" } }
</script>

<script type="module">
import * as THREE from 'three';

// ==================== مراحل ====================
const LEVELS = [
  { name: '🌱 چمن سبز', sky: 0x87CEEB, fog: 0x87CEEB, fogN: 60, fogF: 220,
    ground: 0x3d8b37, cover: 0x8B7355, tuft: 0x2d6b27,
    enemies: 5, gunner: 0, speed: 0, allies: 0 },
  { name: '🌲 جنگل تاریک', sky: 0x2a4a2a, fog: 0x1a3a1a, fogN: 30, fogF: 150,
    ground: 0x1e4d1e, cover: 0x5a4a30, tuft: 0x0d3d0d,
    enemies: 8, gunner: 0.4, speed: 0.3, allies: 0 },
  { name: '🏜️ بیابان', sky: 0xffa54f, fog: 0xffb070, fogN: 50, fogF: 200,
    ground: 0xd9a860, cover: 0x8b6f3a, tuft: 0xb89040,
    enemies: 10, gunner: 0.6, speed: 0.5, allies: 1 },
  { name: '❄️ برفی', sky: 0xb8d8e8, fog: 0xd8e8f0, fogN: 40, fogF: 180,
    ground: 0xe8f0f5, cover: 0x8fa0b0, tuft: 0xffffff,
    enemies: 12, gunner: 0.7, speed: 0.7, allies: 2 },
  { name: '🌋 آتشفشان', sky: 0x8b1a1a, fog: 0x5a0a0a, fogN: 30, fogF: 140,
    ground: 0x3a1a1a, cover: 0x4a2020, tuft: 0x1a0808,
    enemies: 14, gunner: 0.8, speed: 1, allies: 3 },
  { name: '🌙 شب مهتابی', sky: 0x0a1a3a, fog: 0x102040, fogN: 35, fogF: 160,
    ground: 0x2a3a4a, cover: 0x3a4a5a, tuft: 0x1a2a3a,
    enemies: 16, gunner: 0.9, speed: 1.3, allies: 4 },
  { name: '👑 زمین پادشاه', sky: 0x4a1a6a, fog: 0x2a0a4a, fogN: 25, fogF: 130,
    ground: 0x4a2a6a, cover: 0x6a4a8a, tuft: 0x3a1a5a,
    enemies: 20, gunner: 1, speed: 1.6, allies: 5 },
];

let currentLevel = 0;
let enemiesRemaining = 0;
let alliesRemaining = 0;

// ==================== صحنه ====================
const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(75, innerWidth/innerHeight, 0.1, 600);
const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
renderer.setSize(innerWidth, innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.shadowMap.enabled = true;
document.body.appendChild(renderer.domElement);

scene.add(new THREE.AmbientLight(0xffffff, 0.7));
const sun = new THREE.DirectionalLight(0xffffff, 1);
sun.position.set(50, 100, 50);
sun.castShadow = true;
sun.shadow.mapSize.set(1024, 1024);
sun.shadow.camera.left = -80; sun.shadow.camera.right = 80;
sun.shadow.camera.top = 80; sun.shadow.camera.bottom = -80;
scene.add(sun);

// ==================== زمین ====================
function groundHeight(x, z) {
  const dist = Math.sqrt(x*x + z*z);
  const damp = Math.min(1, dist / 20);
  return (Math.sin(x*0.05) * Math.cos(z*0.05) * 1.5 +
    Math.sin(x*0.15 + 1) * Math.cos(z*0.12) * 0.6 +
    Math.sin(x*0.3) * 0.3) * damp;
}

let groundMesh = null, tuftMeshes = [], coverMeshes = [];
const covers = [];

function clearWorld() {
  if (groundMesh) scene.remove(groundMesh);
  tuftMeshes.forEach(t => scene.remove(t));
  coverMeshes.forEach(c => scene.remove(c));
  tuftMeshes = []; coverMeshes = []; covers.length = 0;
}

function buildWorld(L) {
  clearWorld();
  scene.background = new THREE.Color(L.sky);
  scene.fog = new THREE.Fog(L.fog, L.fogN, L.fogF);

  const gGeo = new THREE.PlaneGeometry(300, 300, 80, 80);
  gGeo.rotateX(-Math.PI/2);
  const gp = gGeo.attributes.position;
  for (let i = 0; i < gp.count; i++) gp.setY(i, groundHeight(gp.getX(i), gp.getZ(i)));
  gp.needsUpdate = true;
  gGeo.computeVertexNormals();

  groundMesh = new THREE.Mesh(gGeo, new THREE.MeshStandardMaterial({ color: L.ground, roughness: 0.95 }));
  groundMesh.receiveShadow = true;
  scene.add(groundMesh);

  const tuftMat = new THREE.MeshStandardMaterial({ color: L.tuft });
  for (let i = 0; i < 120; i++) {
    const a = Math.random() * Math.PI * 2;
    const r = 15 + Math.random() * 100;
    const x = Math.cos(a)*r, z = Math.sin(a)*r;
    const tuft = new THREE.Mesh(new THREE.ConeGeometry(0.3, 0.8, 4), tuftMat);
    tuft.position.set(x, groundHeight(x,z) + 0.3, z);
    scene.add(tuft); tuftMeshes.push(tuft);
  }

  const coverMat = new THREE.MeshStandardMaterial({ color: L.cover, roughness: 1 });
  [[10, 10, 4, 2, 1.5], [-15, 8, 5, 1.5, 2], [15, -12, 3, 2, 2],
   [-20, -15, 4, 1.5, 2.5], [0, 20, 6, 2, 1.5], [-25, 5, 3, 1.5, 2],
   [25, 20, 4, 2, 2], [-30, -20, 5, 2, 1.8]].forEach(([x, z, w, h, d]) => {
    const cover = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), coverMat);
    cover.position.set(x, groundHeight(x,z) + h/2, z);
    cover.castShadow = true; cover.receiveShadow = true;
    scene.add(cover);
    coverMeshes.push(cover);
    covers.push({ mesh: cover, w, h, d });
  });
}

// ==================== آیتم‌ها ====================
let pickups = [];
const ammoMat = new THREE.MeshStandardMaterial({ color: 0x22cc22, emissive: 0x115511 });
const healthMat = new THREE.MeshStandardMaterial({ color: 0xcc2222, emissive: 0x551111 });

function spawnPickup(x, z, type) {
  const mesh = new THREE.Mesh(new THREE.BoxGeometry(1, 1, 1), type === 'ammo' ? ammoMat : healthMat);
  mesh.position.set(x, groundHeight(x,z) + 1, z);
  mesh.castShadow = true;
  scene.add(mesh);
  pickups.push({ mesh, type, bob: Math.random()*Math.PI*2 });
}

function buildPickups() {
  for (let i = 0; i < 12; i++) {
    const a = Math.random()*Math.PI*2, r = 20 + Math.random()*80;
    spawnPickup(Math.cos(a)*r, Math.sin(a)*r, 'ammo');
  }
  for (let i = 0; i < 5; i++) {
    const a = Math.random()*Math.PI*2, r = 30 + Math.random()*70;
    spawnPickup(Math.cos(a)*r, Math.sin(a)*r, 'health');
  }
}

// ==================== سلاح‌ها ====================
const WEAPONS = {
  pistol:  { name: 'کلت',    maxAmmo: 12, damage: 30, fireRate: 0.25, range: 60, spread: 0.02, auto: false, zoom: 1.2, kick: 0.03 },
  rifle:   { name: 'رگبار',   maxAmmo: 30, damage: 20, fireRate: 0.1, range: 80, spread: 0.025, auto: true, zoom: 1.3, kick: 0.015 },
  sniper:  { name: 'اسنایپ',  maxAmmo: 8,  damage: 100, fireRate: 0.8, range: 200, spread: 0.001, auto: false, zoom: 4, kick: 0.09 },
  shotgun: { name: 'شات‌گان', maxAmmo: 6,  damage: 60, fireRate: 0.7, range: 20, spread: 0.15, auto: false, zoom: 1.1, kick: 0.07, pellets: 8 }
};

let currentWeapon = 'pistol';
let ammo = { pistol: 12, rifle: 30, sniper: 8, shotgun: 6 };

let player = {
  pos: new THREE.Vector3(0, 0, 0), yaw: 0, pitch: 0,
  health: 10, maxHealth: 10, speed: 8,
  lastShot: 0, zooming: false, height: 1.7, bobTime: 0,
  recoilOffset: 0, recoilPitch: 0, recoilRoll: 0,
};

// ==================== اسلحه در دست ====================
let weaponGroup = new THREE.Group();
scene.add(weaponGroup);
const WEAPON_BASE_POS = new THREE.Vector3(0.32, -0.28, -0.6);
weaponGroup.position.copy(WEAPON_BASE_POS);

// -- کلت --
const pistolGroup = new THREE.Group();
const pBody = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.14, 0.45),
  new THREE.MeshStandardMaterial({ color: 0x222222, roughness: 0.7, metalness: 0.6 }));
pBody.position.set(0, 0, -0.22);
pistolGroup.add(pBody);
const pBarrel = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, 0.25, 8),
  new THREE.MeshStandardMaterial({ color: 0x111111, metalness: 0.8 }));
pBarrel.rotation.x = Math.PI/2;
pBarrel.position.set(0, 0.02, -0.55);
pistolGroup.add(pBarrel);
const pGrip = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.22, 0.1),
  new THREE.MeshStandardMaterial({ color: 0x1a1a1a }));
pGrip.position.set(0, -0.17, -0.05);
pistolGroup.add(pGrip);
weaponGroup.add(pistolGroup);

// -- رگبار --
const rifleGroup = new THREE.Group();
const rBody = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.15, 0.9),
  new THREE.MeshStandardMaterial({ color: 0x2a2a2a, roughness: 0.7, metalness: 0.6 }));
rBody.position.set(0, 0, -0.4);
rifleGroup.add(rBody);
const rBarrel = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.04, 0.7, 8),
  new THREE.MeshStandardMaterial({ color: 0x111111, metalness: 0.8 }));
rBarrel.rotation.x = Math.PI/2;
rBarrel.position.set(0, 0.02, -1.0);
rifleGroup.add(rBarrel);
const rMag = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.28, 0.15),
  new THREE.MeshStandardMaterial({ color: 0x333333 }));
rMag.position.set(0, -0.2, -0.3);
rifleGroup.add(rMag);
const rGrip = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.2, 0.1),
  new THREE.MeshStandardMaterial({ color: 0x1a1a1a }));
rGrip.position.set(0, -0.15, 0.1);
rifleGroup.add(rGrip);
weaponGroup.add(rifleGroup);

// -- اسنایپ --
const sniperGroup = new THREE.Group();
const sBody = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.12, 1.2),
  new THREE.MeshStandardMaterial({ color: 0x1a3a1a, roughness: 0.7, metalness: 0.5 }));
sBody.position.set(0, 0, -0.5);
sniperGroup.add(sBody);
const sBarrel = new THREE.Mesh(new THREE.CylinderGeometry(0.035, 0.035, 1.1, 8),
  new THREE.MeshStandardMaterial({ color: 0x0a0a0a, metalness: 0.9 }));
sBarrel.rotation.x = Math.PI/2;
sBarrel.position.set(0, 0.02, -1.35);
sniperGroup.add(sBarrel);
const sScope = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, 0.35, 12),
  new THREE.MeshStandardMaterial({ color: 0x000000, metalness: 0.9, roughness: 0.2 }));
sScope.rotation.x = Math.PI/2;
sScope.position.set(0, 0.14, -0.5);
sniperGroup.add(sScope);
const sGrip = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.2, 0.1),
  new THREE.MeshStandardMaterial({ color: 0x1a1a1a }));
sGrip.position.set(0, -0.14, -0.05);
sniperGroup.add(sGrip);
const sMag = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.2, 0.12),
  new THREE.MeshStandardMaterial({ color: 0x333333 }));
sMag.position.set(0, -0.18, -0.4);
sniperGroup.add(sMag);
weaponGroup.add(sniperGroup);

// -- شات‌گان --
const shotgunGroup = new THREE.Group();
const shBody = new THREE.Mesh(new THREE.BoxGeometry(0.14, 0.16, 0.7),
  new THREE.MeshStandardMaterial({ color: 0x4a2a1a, roughness: 0.9 }));
shBody.position.set(0, 0, -0.35);
shotgunGroup.add(shBody);
const shBarrel1 = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, 0.85, 8),
  new THREE.MeshStandardMaterial({ color: 0x1a1a1a, metalness: 0.8 }));
shBarrel1.rotation.x = Math.PI/2;
shBarrel1.position.set(-0.05, 0.04, -1.0);
shotgunGroup.add(shBarrel1);
const shBarrel2 = shBarrel1.clone();
shBarrel2.position.set(0.05, 0.04, -1.0);
shotgunGroup.add(shBarrel2);
const shGrip = new THREE.Mesh(new THREE.BoxGeometry(0.09, 0.22, 0.1),
  new THREE.MeshStandardMaterial({ color: 0x3a1a0a }));
shGrip.position.set(0, -0.17, 0.05);
shotgunGroup.add(shGrip);
const shPump = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.1, 0.25),
  new THREE.MeshStandardMaterial({ color: 0x2a1a0a }));
shPump.position.set(0, -0.08, -0.7);
shotgunGroup.add(shPump);
weaponGroup.add(shotgunGroup);

// مخفی کردن همه، بعداً فقط سلاح فعال رو نشون بده
function showWeaponModel(w) {
  pistolGroup.visible = false;
  rifleGroup.visible = false;
  sniperGroup.visible = false;
  shotgunGroup.visible = false;
  if (w === 'pistol') pistolGroup.visible = true;
  else if (w === 'rifle') rifleGroup.visible = true;
  else if (w === 'sniper') sniperGroup.visible = true;
  else if (w === 'shotgun') shotgunGroup.visible = true;
}
showWeaponModel('pistol');

// ==================== افکت شعله ====================
const muzzleGroup = new THREE.Group();
weaponGroup.add(muzzleGroup);
const flashCore = new THREE.Mesh(new THREE.SphereGeometry(0.12, 8, 8),
  new THREE.MeshBasicMaterial({ color: 0xffffaa, transparent: true, opacity: 0 }));
muzzleGroup.add(flashCore);
const flashCone = new THREE.Mesh(new THREE.ConeGeometry(0.15, 0.45, 6),
  new THREE.MeshBasicMaterial({ color: 0xffaa00, transparent: true, opacity: 0 }));
flashCone.rotation.x = -Math.PI/2;
flashCone.position.z = -0.2;
muzzleGroup.add(flashCone);
const muzzleLight = new THREE.PointLight(0xffaa33, 0, 8);
muzzleGroup.add(muzzleLight);

let flashTime = 0;
const FLASH_DURATION = 0.06;

function updateMuzzlePos() {
  if (currentWeapon === 'pistol') muzzleGroup.position.set(0, 0.02, -0.7);
  else if (currentWeapon === 'rifle') muzzleGroup.position.set(0, 0.02, -1.35);
  else if (currentWeapon === 'sniper') muzzleGroup.position.set(0, 0.02, -1.9);
  else if (currentWeapon === 'shotgun') muzzleGroup.position.set(0, 0.04, -1.45);
}
updateMuzzlePos();

function triggerFlash() {
  flashTime = FLASH_DURATION;
  flashCore.material.opacity = 1;
  flashCone.material.opacity = 0.9;
  muzzleLight.intensity = 4;
}

function updateFlash(dt) {
  if (flashTime > 0) {
    flashTime -= dt;
    const t = Math.max(0, flashTime / FLASH_DURATION);
    flashCore.material.opacity = t;
    flashCone.material.opacity = t * 0.9;
    muzzleLight.intensity = t * 4;
  } else {
    flashCore.material.opacity = 0;
    flashCone.material.opacity = 0;
    muzzleLight.intensity = 0;
  }
}

// ==================== دشمنان ====================
let enemies = [];
const enemyBodyMat = new THREE.MeshStandardMaterial({ color: 0x222288 });
const enemyHeadMat = new THREE.MeshStandardMaterial({ color: 0xddb088 });
const enemyGunMat = new THREE.MeshStandardMaterial({ color: 0x333333 });

function createEnemy(x, z, hasGun, speedBonus) {
  const group = new THREE.Group();
  const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.4, 1.0, 4, 8), enemyBodyMat);
  body.position.y = 1.0; body.castShadow = true; group.add(body);
  const head = new THREE.Mesh(new THREE.SphereGeometry(0.3, 12, 12), enemyHeadMat);
  head.position.y = 1.85; head.castShadow = true; group.add(head);
  const eye = new THREE.Mesh(new THREE.SphereGeometry(0.05, 6, 6),
    new THREE.MeshBasicMaterial({ color: 0xff2222 }));
  eye.position.set(0, 1.9, -0.28); group.add(eye);
  if (hasGun) {
    const gun = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.15, 1.2), enemyGunMat);
    gun.position.set(0.4, 1.3, 0.5); gun.castShadow = true; group.add(gun);
  }
  group.position.set(x, groundHeight(x,z), z);
  scene.add(group);
  enemies.push({ group, health: 100, hasGun, gunCooldown: 2 + Math.random()*2,
    speed: 2 + Math.random()*1.5 + speedBonus, lastAttack: 0, alive: true });
}

// ==================== یارها (همرزم) ====================
let allies = [];
const allyBodyMat = new THREE.MeshStandardMaterial({ color: 0x228822 });
const allyHeadMat = new THREE.MeshStandardMaterial({ color: 0xddb088 });
const allyGunMat = new THREE.MeshStandardMaterial({ color: 0x444444 });

function createAlly(x, z) {
  const group = new THREE.Group();
  const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.4, 1.0, 4, 8), allyBodyMat);
  body.position.y = 1.0; body.castShadow = true; group.add(body);
  const head = new THREE.Mesh(new THREE.SphereGeometry(0.3, 12, 12), allyHeadMat);
  head.position.y = 1.85; head.castShadow = true; group.add(head);
  const eye = new THREE.Mesh(new THREE.SphereGeometry(0.05, 6, 6),
    new THREE.MeshBasicMaterial({ color: 0x00ff00 }));
  eye.position.set(0, 1.9, -0.28); group.add(eye);
  const gun = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.15, 1.2), allyGunMat);
  gun.position.set(0.4, 1.3, 0.5); gun.castShadow = true; group.add(gun);
  group.position.set(x, groundHeight(x,z), z);
  scene.add(group);
  allies.push({
    group, health: 100, alive: true,
    gunCooldown: 1.5 + Math.random()*1.5, lastAttack: 0,
    speed: 4 + Math.random()*1.5,
    followOffset: new THREE.Vector3((Math.random()-0.5)*8, 0, (Math.random()-0.5)*8),
  });
}

// ==================== گلوله ====================
let bullets = [];
const bulletGeo = new THREE.SphereGeometry(0.08, 6, 6);
const bulletMat = new THREE.MeshBasicMaterial({ color: 0xffff00 });
const enemyBulletMat = new THREE.MeshBasicMaterial({ color: 0xff3300 });
const allyBulletMat = new THREE.MeshBasicMaterial({ color: 0x00ff00 });

function spawnBulletVisual(from, to, color) {
  const dir = new THREE.Vector3().subVectors(to, from);
  const len = dir.length();
  dir.normalize();
  const trailGeo = new THREE.BufferGeometry().setFromPoints([from.clone(), to.clone()]);
  const trailMat = new THREE.LineBasicMaterial({ color, transparent: true, opacity: 0.8 });
  const trail = new THREE.Line(trailGeo, trailMat);
  scene.add(trail);
  setTimeout(() => scene.remove(trail), 100);
  const bullet = new THREE.Mesh(bulletGeo, new THREE.MeshBasicMaterial({ color }));
  bullet.position.copy(from);
  scene.add(bullet);
  bullets.push({ mesh: bullet, dir, speed: 200, traveled: 0, maxDist: len, startPos: from.clone() });
}

// ==================== کنترل‌ها ====================
let joyX = 0, joyY = 0, joyActive = false, joyTouchId = null;
let lookTouchId = null, lastLookX = 0, lastLookY = 0;
let firing = false, zoomTouchId = null;

const joyZone = document.getElementById('joyZone');
const joyKnob = document.getElementById('joyKnob');
const fireBtn = document.getElementById('fireBtn');
const zoomBtn = document.getElementById('zoomBtn');
const reloadBtn = document.getElementById('reloadBtn');

function getCenter(el) {
  const r = el.getBoundingClientRect();
  return { x: r.left + r.width/2, y: r.top + r.height/2, r: r.width/2 };
}

joyZone.addEventListener('touchstart', e => {
  e.preventDefault(); e.stopPropagation();
  const t = e.changedTouches[0];
  joyTouchId = t.identifier; joyActive = true;
  updateJoy(t);
}, { passive: false });
joyZone.addEventListener('touchmove', e => {
  e.preventDefault(); e.stopPropagation();
  for (const t of e.changedTouches) if (t.identifier === joyTouchId) updateJoy(t);
}, { passive: false });
joyZone.addEventListener('touchend', e => {
  e.preventDefault(); e.stopPropagation();
  for (const t of e.changedTouches) {
    if (t.identifier === joyTouchId) {
      joyTouchId = null; joyActive = false; joyX = 0; joyY = 0;
      joyKnob.style.transform = 'translate(-50%,-50%)';
    }
  }
}, { passive: false });

function updateJoy(t) {
  const c = getCenter(joyZone);
  let dx = t.clientX - c.x, dy = t.clientY - c.y;
  const dist = Math.sqrt(dx*dx + dy*dy);
  const maxR = c.r - 8;
  if (dist > maxR) { dx = dx/dist*maxR; dy = dy/dist*maxR; }
  joyKnob.style.transform = `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px))`;
  joyX = dx / maxR; joyY = dy / maxR;
}

document.addEventListener('touchstart', e => {
  if (lookTouchId !== null) return;
  const target = e.target;
  if (target.closest('#joyZone') || target.closest('#fireBtn') ||
      target.closest('#zoomBtn') || target.closest('#reloadBtn') ||
      target.closest('.wbtn') || target.closest('.bigBtn')) return;
  const t = e.changedTouches[0];
  lookTouchId = t.identifier;
  lastLookX = t.clientX; lastLookY = t.clientY;
}, { passive: true });

document.addEventListener('touchmove', e => {
  for (const t of e.changedTouches) {
    if (t.identifier === lookTouchId) {
      const dx = t.clientX - lastLookX;
      const dy = t.clientY - lastLookY;
      lastLookX = t.clientX; lastLookY = t.clientY;
      const sens = player.zooming ? 0.0008 : 0.0035;
      player.yaw -= dx * sens;
      player.pitch -= dy * sens;
      player.pitch = Math.max(-Math.PI/2 + 0.1, Math.min(Math.PI/2 - 0.1, player.pitch));
    }
  }
}, { passive: true });

document.addEventListener('touchend', e => {
  for (const t of e.changedTouches) {
    if (t.identifier === lookTouchId) lookTouchId = null;
    if (t.identifier === zoomTouchId) { zoomTouchId = null; player.zooming = false; }
  }
}, { passive: true });

fireBtn.addEventListener('touchstart', e => { e.preventDefault(); e.stopPropagation(); firing = true; }, { passive: false });
fireBtn.addEventListener('touchend', e => { e.preventDefault(); e.stopPropagation(); firing = false; }, { passive: false });

zoomBtn.addEventListener('touchstart', e => {
  e.preventDefault(); e.stopPropagation();
  zoomTouchId = e.changedTouches[0].identifier;
  player.zooming = true;
}, { passive: false });
zoomBtn.addEventListener('touchend', e => {
  e.preventDefault(); e.stopPropagation();
  player.zooming = false; zoomTouchId = null;
}, { passive: false });

reloadBtn.addEventListener('touchstart', e => { e.preventDefault(); e.stopPropagation(); reload(); }, { passive: false });

document.querySelectorAll('.wbtn').forEach(btn => {
  btn.addEventListener('touchstart', e => {
    e.preventDefault(); e.stopPropagation();
    switchWeapon(btn.dataset.w);
  }, { passive: false });
});

const keysDown = {};
addEventListener('keydown', e => {
  keysDown[e.code] = true;
  if (e.code === 'Digit1') switchWeapon('pistol');
  if (e.code === 'Digit2') switchWeapon('rifle');
  if (e.code === 'Digit3') switchWeapon('sniper');
  if (e.code === 'Digit4') switchWeapon('shotgun');
  if (e.code === 'KeyR') reload();
  if (e.code === 'Space') firing = true;
});
addEventListener('keyup', e => {
  keysDown[e.code] = false;
  if (e.code === 'Space') firing = false;
});

// ==================== توابع UI ====================
function switchWeapon(w) {
  if (currentWeapon === w) return;
  currentWeapon = w;
  document.getElementById('weapon').textContent = WEAPONS[w].name;
  document.querySelectorAll('.wbtn').forEach(b => {
    b.classList.toggle('active', b.dataset.w === w);
  });
  showWeaponModel(w);
  updateMuzzlePos();
  updateAmmoUI();
  // انیمیشن تغییر
  weaponGroup.position.y = WEAPON_BASE_POS.y - 0.25;
}

function reload() {
  ammo[currentWeapon] = WEAPONS[currentWeapon].maxAmmo;
  updateAmmoUI();
}

function updateAmmoUI() {
  const w = WEAPONS[currentWeapon];
  document.getElementById('ammo').textContent = `🔫 ${ammo[currentWeapon]}/${w.maxAmmo}`;
}

function updateHealthUI() {
  document.getElementById('health').textContent = `❤️ ${player.health}`;
}

function updateEnemyCountUI() {
  document.getElementById('enemyCount').textContent = `👥 ${enemiesRemaining}`;
}

function updateAllyCountUI() {
  document.getElementById('allyCount').textContent = `🤝 ${allies.filter(a => a.alive).length}`;
}

function updateLevelUI() {
  document.getElementById('level').textContent = `🎯 مرحله ${currentLevel+1}/7 - ${LEVELS[currentLevel].name}`;
}

function showDamageOverlay() {
  const ov = document.getElementById('damageOverlay');
  ov.style.opacity = 1;
  setTimeout(() => ov.style.opacity = 0, 200);
}

let msgTimer = 0;
function showMsg(text, duration = 2) {
  const el = document.getElementById('msg');
  el.textContent = text;
  el.style.opacity = 1;
  msgTimer = duration;
}

// ==================== شلیک ====================
function shoot(now) {
  const w = WEAPONS[currentWeapon];
  if (ammo[currentWeapon] <= 0) return;
  if (now - player.lastShot < w.fireRate) return;

  player.lastShot = now;
  ammo[currentWeapon]--;
  updateAmmoUI();

  triggerFlash();
  player.recoilOffset = 0.12 * (w.kick * 10);
  player.recoilPitch = w.kick;
  player.recoilRoll = (Math.random() - 0.5) * w.kick * 1.5;

  const baseDir = new THREE.Vector3(0, 0, -1).applyEuler(
    new THREE.Euler(player.pitch, player.yaw, 0, 'YXZ'));
  const pellets = w.pellets || 1;
  const hitEnemies = new Set();

  for (let p = 0; p < pellets; p++) {
    const dir = baseDir.clone();
    dir.x += (Math.random() - 0.5) * w.spread * 2;
    dir.y += (Math.random() - 0.5) * w.spread * 2;
    dir.z += (Math.random() - 0.5) * w.spread * 2;
    dir.normalize();

    const origin = camera.position.clone();
    let closestHit = null, closestDist = Infinity;

    for (const enemy of enemies) {
      if (!enemy.alive) continue;
      const ec = enemy.group.position.clone().add(new THREE.Vector3(0, 1.2, 0));
      const toE = new THREE.Vector3().subVectors(ec, origin);
      const proj = toE.dot(dir);
      if (proj < 0 || proj > w.range) continue;
      const cp = origin.clone().add(dir.clone().multiplyScalar(proj));
      const d = cp.distanceTo(ec);
      const hitR = currentWeapon === 'shotgun' ? 1.0 : 0.8;
      if (d < hitR && proj < closestDist) { closestDist = proj; closestHit = enemy; }
    }

    if (closestHit) {
      const hp = origin.clone().add(dir.clone().multiplyScalar(closestDist));
      spawnBulletVisual(origin, hp, 0xffff66);
      if (!hitEnemies.has(closestHit)) {
        hitEnemies.add(closestHit);
        closestHit.health -= w.damage;
        if (closestHit.health <= 0) killEnemy(closestHit);
      }
    } else {
      let endPoint = origin.clone().add(dir.clone().multiplyScalar(w.range));
      for (let t = 0; t < w.range; t += 2) {
        const pt = origin.clone().add(dir.clone().multiplyScalar(t));
        if (pt.y < groundHeight(pt.x, pt.z)) { endPoint = pt; break; }
        if (Math.abs(pt.x) > 150 || Math.abs(pt.z) > 150) { endPoint = pt; break; }
      }
      spawnBulletVisual(origin, endPoint, 0xffff66);
    }
  }
}

function killEnemy(enemy) {
  enemy.alive = false;
  scene.remove(enemy.group);
  enemiesRemaining--;
  updateEnemyCountUI();
  if (Math.random() < 0.4) {
    spawnPickup(enemy.group.position.x, enemy.group.position.z,
                Math.random() < 0.7 ? 'ammo' : 'health');
  }
}

// ==================== به‌روزرسانی دشمنان ====================
function updateEnemies(dt, now) {
  for (const enemy of enemies) {
    if (!enemy.alive) continue;
    const ep = enemy.group.position;
    const toP = new THREE.Vector3().subVectors(player.pos, ep);
    toP.y = 0;
    const dist = toP.length();
    toP.normalize();

    const ta = Math.atan2(toP.x, toP.z);
    let ad = ta - enemy.group.rotation.y;
    while (ad > Math.PI) ad -= Math.PI*2;
    while (ad < -Math.PI) ad += Math.PI*2;
    enemy.group.rotation.y += ad * dt * 3;

    const maxR = enemy.hasGun ? 15 : 1.5;
    if (dist > maxR) {
      const ms = enemy.speed * dt;
      const nx = ep.x + toP.x * ms;
      const nz = ep.z + toP.z * ms;
      let blocked = false;
      for (const c of covers) {
        const dx = nx - c.mesh.position.x;
        const dz = nz - c.mesh.position.z;
        if (Math.abs(dx) < c.w/2 + 0.5 && Math.abs(dz) < c.d/2 + 0.5) { blocked = true; break; }
      }
      if (!blocked) { ep.x = nx; ep.z = nz; ep.y = groundHeight(nx, nz); }
    }

    if (enemy.hasGun && dist < 25 && dist > 2) {
      if (now - enemy.lastAttack > enemy.gunCooldown) {
        enemy.lastAttack = now;
        enemy.gunCooldown = 1.5 + Math.random()*1.5;
        if (Math.random() < 0.65) {
          player.health--;
          updateHealthUI();
          showDamageOverlay();
          const s = ep.clone().add(new THREE.Vector3(0, 1.3, 0));
          spawnBulletVisual(s, camera.position.clone(), 0xff3300);
        }
      }
    } else if (dist < 2 && now - enemy.lastAttack > 1) {
      enemy.lastAttack = now;
      player.health--;
      updateHealthUI();
      showDamageOverlay();
    }
  }
}

// ==================== به‌روزرسانی یارها ====================
function updateAllies(dt, now) {
  for (const ally of allies) {
    if (!ally.alive) continue;
    const ap = ally.group.position;

    // پیدا کردن نزدیک‌ترین دشمن
    let target = null, minD = Infinity;
    for (const enemy of enemies) {
      if (!enemy.alive) continue;
      const d = ap.distanceTo(enemy.group.position);
      if (d < minD) { minD = d; target = enemy; }
    }

    // حرکت
    let moveTarget;
    if (target && minD < 30) {
      // به سمت دشمن
      moveTarget = target.group.position.clone();
      moveTarget.x += 8; // فاصله نگه‌دار
    } else {
      // دنبال بازیکن
      moveTarget = player.pos.clone().add(ally.followOffset);
    }

    const toT = new THREE.Vector3().subVectors(moveTarget, ap);
    toT.y = 0;
    const d = toT.length();
    if (d > 3) {
      toT.normalize();
      const ms = ally.speed * dt;
      const nx = ap.x + toT.x * ms;
      const nz = ap.z + toT.z * ms;
      let blocked = false;
      for (const c of covers) {
        const ddx = nx - c.mesh.position.x;
        const ddz = nz - c.mesh.position.z;
        if (Math.abs(ddx) < c.w/2 + 0.5 && Math.abs(ddz) < c.d/2 + 0.5) { blocked = true; break; }
      }
      if (!blocked) { ap.x = nx; ap.z = nz; ap.y = groundHeight(nx, nz); }
    }

    // چرخش به سمت دشمن
    if (target) {
      const toE = new THREE.Vector3().subVectors(target.group.position, ap);
      toE.y = 0;
      const ta = Math.atan2(toE.x, toE.z);
      let ad = ta - ally.group.rotation.y;
      while (ad > Math.PI) ad -= Math.PI*2;
      while (ad < -Math.PI) ad += Math.PI*2;
      ally.group.rotation.y += ad * dt * 5;

      // شلیک
      if (minD < 30 && now - ally.lastAttack > ally.gunCooldown) {
        ally.lastAttack = now;
        ally.gunCooldown = 0.8 + Math.random()*1.2;
        if (Math.random() < 0.7) {
          const s = ap.clone().add(new THREE.Vector3(0, 1.3, 0));
          spawnBulletVisual(s, target.group.position.clone().add(new THREE.Vector3(0,1.2,0)), 0x00ff00);
          target.health -= 25;
          if (target.health <= 0) killEnemy(target);
        }
      }
    }
  }
}

// ==================== به‌روزرسانی بازیکن ====================
function updatePlayer(dt) {
  const fwd = new THREE.Vector3(-Math.sin(player.yaw), 0, -Math.cos(player.yaw));
  const right = new THREE.Vector3(Math.cos(player.yaw), 0, -Math.sin(player.yaw));

  let move = new THREE.Vector3();
  if (joyActive && (Math.abs(joyX) > 0.1 || Math.abs(joyY) > 0.1)) {
    move.add(fwd.clone().multiplyScalar(-joyY));
    move.add(right.clone().multiplyScalar(joyX));
  }
  if (keysDown['KeyW']) move.add(fwd);
  if (keysDown['KeyS']) move.sub(fwd);
  if (keysDown['KeyD']) move.add(right);
  if (keysDown['KeyA']) move.sub(right);

  const moving = move.length() > 0;
  if (moving) {
    move.normalize();
    const speed = player.speed * dt;
    let nx = player.pos.x + move.x * speed;
    let nz = player.pos.z + move.z * speed;
    for (const c of covers) {
      const dx = nx - c.mesh.position.x;
      const dz = nz - c.mesh.position.z;
      if (Math.abs(dx) < c.w/2 + 0.4 && Math.abs(dz) < c.d/2 + 0.4) {
        if (Math.abs(dx) > Math.abs(dz)) nx = player.pos.x;
        else nz = player.pos.z;
      }
    }
    nx = Math.max(-140, Math.min(140, nx));
    nz = Math.max(-140, Math.min(140, nz));
    player.pos.x = nx; player.pos.z = nz;
    player.bobTime += dt * 12;
  } else player.bobTime *= 0.95;

  player.pos.y = groundHeight(player.pos.x, player.pos.z) + player.height;

  const w = WEAPONS[currentWeapon];
  const targetFov = player.zooming ? 75 / w.zoom : 75;
  camera.fov += (targetFov - camera.fov) * Math.min(1, dt * 12);
  camera.updateProjectionMatrix();

  if (player.recoilPitch > 0.0001) {
    player.recoilPitch *= 0.82;
    player.recoilRoll *= 0.82;
  } else { player.recoilPitch = 0; player.recoilRoll = 0; }
}

function updateWeapon(dt) {
  const bobX = Math.sin(player.bobTime) * 0.008;
  const bobY = Math.abs(Math.cos(player.bobTime)) * 0.012;
  const isMoving = joyActive || keysDown['KeyW']||keysDown['KeyA']||keysDown['KeyS']||keysDown['KeyD'];
  const tbx = isMoving ? bobX : 0;
  const tby = isMoving ? bobY : 0;
  const zf = camera.fov / 75;
  const bx = WEAPON_BASE_POS.x * (0.4 + zf * 0.6);
  const by = WEAPON_BASE_POS.y * (0.4 + zf * 0.6);
  const bz = WEAPON_BASE_POS.z;
  const rb = player.recoilOffset;
  const ru = player.recoilOffset * 0.6;
  if (player.recoilOffset > 0.001) player.recoilOffset *= 0.78;
  else player.recoilOffset = 0;
  weaponGroup.position.x += (bx + tbx - weaponGroup.position.x) * Math.min(1, dt*15);
  weaponGroup.position.y += (by + tby + ru - weaponGroup.position.y) * Math.min(1, dt*20);
  weaponGroup.position.z += (bz + rb - weaponGroup.position.z) * Math.min(1, dt*20);
  weaponGroup.rotation.x = -player.recoilOffset * 3;
  weaponGroup.rotation.z = player.recoilRoll * 2;
}

// ==================== آیتم‌ها ====================
function updatePickups(dt) {
  for (let i = pickups.length - 1; i >= 0; i--) {
    const p = pickups[i];
    p.bob += dt * 3;
    p.mesh.position.y = groundHeight(p.mesh.position.x, p.mesh.position.z) + 1 + Math.sin(p.bob) * 0.2;
    p.mesh.rotation.y += dt;
    const dx = p.mesh.position.x - player.pos.x;
    const dz = p.mesh.position.z - player.pos.z;
    if (dx*dx + dz*dz < 4) {
      if (p.type === 'ammo') {
        for (const k in ammo) ammo[k] = WEAPONS[k].maxAmmo;
        updateAmmoUI();
        showMsg('مهمات پر شد!', 1);
      } else {
        player.health = Math.min(player.maxHealth, player.health + 3);
        updateHealthUI();
        showMsg('جان +3', 1);
      }
      scene.remove(p.mesh);
      pickups.splice(i, 1);
    }
  }
}

// ==================== گلوله‌ها ====================
function updateBullets(dt) {
  for (let i = bullets.length - 1; i >= 0; i--) {
    const b = bullets[i];
    b.traveled += b.speed * dt;
    b.mesh.position.copy(b.startPos).add(b.dir.clone().multiplyScalar(b.traveled));
    if (b.traveled > b.maxDist) {
      scene.remove(b.mesh);
      bullets.splice(i, 1);
    }
  }
}

// ==================== مدیریت مراحل ====================
function startLevel(levelIndex) {
  currentLevel = levelIndex;
  const L = LEVELS[levelIndex];
  buildWorld(L);

  // پاک کردن دشمنان و یارهای قبلی
  enemies.forEach(e => scene.remove(e.group));
  allies.forEach(a => scene.remove(a.group));
  enemies = []; allies = [];

  // ساخت دشمنان جدید
  for (let i = 0; i < L.enemies; i++) {
    const a = Math.random()*Math.PI*2;
    const r = 25 + Math.random()*60;
    const hasGun = Math.random() < L.gunner;
    createEnemy(Math.cos(a)*r, Math.sin(a)*r, hasGun, L.speed);
  }
  enemiesRemaining = L.enemies;
  updateEnemyCountUI();

  // ساخت یارها
  for (let i = 0; i < L.allies; i++) {
    const a = (i / L.allies) * Math.PI * 2;
    const r = 5;
    createAlly(player.pos.x + Math.cos(a)*r, player.pos.z + Math.sin(a)*r);
  }
  updateAllyCountUI();

  // ریست بازیکن
  player.pos.set(0, 0, 0);
  player.yaw = 0; player.pitch = 0;
  player.health = player.maxHealth;
  updateHealthUI();
  for (const k in ammo) ammo[k] = WEAPONS[k].maxAmmo;
  updateAmmoUI();

  // آیتم‌ها
  pickups.forEach(p => scene.remove(p.mesh));
  pickups = [];
  buildPickups();

  updateLevelUI();
  showMsg(`🎯 مرحله ${levelIndex+1}: ${L.name}`, 2.5);
}

// ==================== مدیریت بازی ====================
let gameOver = false;
let running = false;
let clockLast = performance.now();

function resetGame() {
  // پاک کردن همه چیز
  enemies.forEach(e => scene.remove(e.group));
  allies.forEach(a => scene.remove(a.group));
  pickups.forEach(p => scene.remove(p.mesh));
  bullets.forEach(b => scene.remove(b.mesh));
  enemies = []; allies = []; pickups = []; bullets = [];

  gameOver = false;
  firing = false;
  joyActive = false; joyX = 0; joyY = 0;
  joyKnob.style.transform = 'translate(-50%,-50%)';

  // شروع مرحله ۱
  startLevel(0);
}

const startScreen = document.getElementById('startScreen');
const startBtn = document.getElementById('startBtn');
const gameOverScreen = document.getElementById('gameOverScreen');
const restartBtn = document.getElementById('restartBtn');
const gameOverTitle = document.getElementById('gameOverTitle');
const gameOverMsg = document.getElementById('gameOverMsg');

function startGame() {
  resetGame();
  startScreen.style.opacity = '0';
  setTimeout(() => { startScreen.style.display = 'none'; }, 400);
  gameOverScreen.style.display = 'none';
  running = true;
  clockLast = performance.now();
}

function endGame(won) {
  gameOver = true;
  running = false;
  if (won) {
    gameOverScreen.classList.add('win');
    gameOverScreen.classList.remove('lose');
    gameOverTitle.textContent = '🏆 بردی!';
    gameOverMsg.textContent = 'هر ۷ مرحله رو با موفقیت رد کردی!';
  } else {
    gameOverScreen.classList.add('lose');
    gameOverScreen.classList.remove('win');
    gameOverTitle.textContent = '💀 باختی!';
    gameOverMsg.textContent = `به مرحله ${currentLevel+1} رسیدی`;
  }
  gameOverScreen.style.display = 'flex';
}

startBtn.addEventListener('click', startGame);
startBtn.addEventListener('touchend', e => { e.preventDefault(); e.stopPropagation(); startGame(); }, { passive: false });
restartBtn.addEventListener('click', () => { gameOverScreen.style.display = 'none'; startGame(); });
restartBtn.addEventListener('touchend', e => { e.preventDefault(); e.stopPropagation(); gameOverScreen.style.display = 'none'; startGame(); }, { passive: false });

// ==================== حلقه اصلی ====================
function animate() {
  requestAnimationFrame(animate);
  const now = performance.now() / 1000;
  const dt = Math.min(0.05, (performance.now() - clockLast) / 1000);
  clockLast = performance.now();

  updateFlash(dt);
  updateWeapon(dt);

  if (running && !gameOver) {
    if (firing) {
      const w = WEAPONS[currentWeapon];
      if (w.auto || now - player.lastShot > w.fireRate) shoot(now);
    }
    updatePlayer(dt);
    updateEnemies(dt, now);
    updateAllies(dt, now);
    updatePickups(dt);
    updateBullets(dt);

    const bobY = Math.sin(player.bobTime * 2) * 0.04;
    camera.position.copy(player.pos);
    camera.position.y += bobY;
    camera.rotation.order = 'YXZ';
    camera.rotation.y = player.yaw;
    camera.rotation.x = player.pitch + player.recoilPitch;
    camera.rotation.z = player.recoilRoll;

    // چک پایان بازی/مرحله
    if (player.health <= 0) {
      endGame(false);
    } else if (enemiesRemaining <= 0) {
      if (currentLevel < LEVELS.length - 1) {
        // مرحله بعد
        currentLevel++;
        startLevel(currentLevel);
        showMsg(`✅ مرحله رد شد! مرحله ${currentLevel+1} شروع شد`, 3);
      } else {
        // برد نهایی
        endGame(true);
      }
    }
  }

  if (msgTimer > 0 && msgTimer < 100) {
    msgTimer -= dt;
    if (msgTimer <= 0) document.getElementById('msg').style.opacity = 0;
  }

  renderer.render(scene, camera);
}

addEventListener('resize', () => {
  camera.aspect = innerWidth / innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});

updateAmmoUI();
updateHealthUI();
updateEnemyCountUI();
updateAllyCountUI();
updateLevelUI();
animate();
</script>
</body>
</html>